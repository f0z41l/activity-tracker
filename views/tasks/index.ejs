<%- include("../partials/header", { title: "To-Do List" }) %>

<div class="page-header">

    <div>

        <h1>To-Do List</h1>

        <p>
            Manage your personal tasks and deadlines.
        </p>

    </div>

    <a
        href="/tasks/add"
        class="btn btn-primary"
    >
        <i data-lucide="plus"></i>
        <span>Add Task</span>
    </a>

</div>


<div class="content-card">

    <!-- SEARCH AND FILTERS -->

    <div class="search-bar">

        <form
            action="/tasks"
            method="GET"
        >

            <input
                type="text"
                name="search"
                placeholder="Search tasks..."
                value="<%= search %>"
            >


            <select name="status">

                <option value="">
                    All Status
                </option>

                <option
                    value="Pending"
                    <%= status === "Pending" ? "selected" : "" %>
                >
                    Pending
                </option>

                <option
                    value="Completed"
                    <%= status === "Completed" ? "selected" : "" %>
                >
                    Completed
                </option>

            </select>


            <select name="priority">

                <option value="">
                    All Priorities
                </option>

                <option
                    value="High"
                    <%= priority === "High" ? "selected" : "" %>
                >
                    High
                </option>

                <option
                    value="Medium"
                    <%= priority === "Medium" ? "selected" : "" %>
                >
                    Medium
                </option>

                <option
                    value="Low"
                    <%= priority === "Low" ? "selected" : "" %>
                >
                    Low
                </option>

            </select>


            <select name="sort">

                <option value="">
                    Due Date: Earliest
                </option>

                <option
                    value="latest"
                    <%= sort === "latest" ? "selected" : "" %>
                >
                    Due Date: Latest
                </option>

                <option
                    value="createdLatest"
                    <%= sort === "createdLatest" ? "selected" : "" %>
                >
                    Recently Added
                </option>

                <option
                    value="createdOldest"
                    <%= sort === "createdOldest" ? "selected" : "" %>
                >
                    Oldest Added
                </option>

            </select>


            <button
                type="submit"
                class="btn btn-secondary"
            >
                <i data-lucide="search"></i>
                <span>Filter</span>
            </button>

        </form>

    </div>


    <% if (tasks.length === 0) { %>

        <div class="empty-state">

            <h2>No tasks found</h2>

            <p>
                Add a task to start managing your to-do list.
            </p>

            <a
                href="/tasks/add"
                class="btn btn-primary"
            >
                <i data-lucide="plus"></i>
                <span>Add Task</span>
            </a>

        </div>

    <% } else { %>


        <div class="task-list">

            <% tasks.forEach(task => { %>

                <div class="task-card">


                    <div class="task-main">

                        <h2 class="<%= task.status === 'Completed' ? 'task-completed' : '' %>">

                            <%= task.title %>

                        </h2>


                        <% if (task.category) { %>

                            <p class="task-category">

                                <i data-lucide="folder"></i>

                                <span>
                                    <%= task.category %>
                                </span>

                            </p>

                        <% } %>


                        <% if (task.dueDate) { %>

                            <p>

                                <i data-lucide="calendar-days"></i>

                                <span>
                                    Due:
                                    <%= new Date(task.dueDate).toLocaleDateString() %>
                                </span>

                            </p>

                        <% } %>


                        <% if (task.remarks) { %>

                            <p class="task-remarks">

                                <i data-lucide="message-square-text"></i>

                                <span>
                                    <%= task.remarks %>
                                </span>

                            </p>

                        <% } %>

                    </div>


                    <div class="task-info">

                        <span class="task-priority <%= task.priority.toLowerCase() %>">

                            <% if (task.priority === "High") { %>

                                <i data-lucide="circle-alert"></i>

                            <% } else if (task.priority === "Medium") { %>

                                <i data-lucide="clock-3"></i>

                            <% } else { %>

                                <i data-lucide="circle-check"></i>

                            <% } %>

                            <span>
                                <%= task.priority %>
                            </span>

                        </span>


                        <span class="status-badge">

                            <% if (task.status === "Completed") { %>

                                <i data-lucide="circle-check"></i>

                            <% } else { %>

                                <i data-lucide="circle"></i>

                            <% } %>

                            <span>
                                <%= task.status %>
                            </span>

                        </span>

                    </div>


                    <div class="card-actions">

                        <a
                            href="/tasks/edit/<%= task._id %>"
                            class="btn btn-secondary"
                        >
                            <i data-lucide="pencil"></i>
                            <span>Edit</span>
                        </a>


                        <form
                            action="/tasks/delete/<%= task._id %>"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Delete this task?')"
                            >
                                <i data-lucide="trash-2"></i>
                                <span>Delete</span>
                            </button>

                        </form>

                    </div>

                </div>

            <% }) %>

        </div>


    <% } %>

</div>


<%- include("../partials/footer") %>