<%- include("../partials/header", { title: "Master's Universities" }) %>

<div class="page-header">

    <div>

        <h1>Master's Universities</h1>

        <p>
            Manage and track master's university opportunities.
        </p>

    </div>

    <a
        href="/universities/add"
        class="btn btn-primary"
    >
        <i data-lucide="plus"></i>
        <span>Add University</span>
    </a>

</div>


<div class="search-bar">

    <form action="/universities" method="GET">

        <input
            type="text"
            name="search"
            placeholder="Search universities..."
            value="<%= search || '' %>"
        >


        <select name="country">

            <option value="">
                All Countries
            </option>

            <% countries.forEach(item => { %>

                <option
                    value="<%= item %>"
                    <%= country === item ? "selected" : "" %>
                >
                    <%= item %>
                </option>

            <% }) %>

        </select>


        <select name="status">

            <option value="">
                All Status
            </option>

            <option
                value="Not Applied"
                <%= status === "Not Applied" ? "selected" : "" %>
            >
                Not Applied
            </option>

            <option
                value="Applied"
                <%= status === "Applied" ? "selected" : "" %>
            >
                Applied
            </option>

        </select>


        <select name="deadline">

            <option value="">
                All Deadlines
            </option>

            <option
                value="open"
                <%= deadline === "open" ? "selected" : "" %>
            >
                Open
            </option>

            <option
                value="closingSoon"
                <%= deadline === "closingSoon" ? "selected" : "" %>
            >
                Closing Soon
            </option>

            <option
                value="expired"
                <%= deadline === "expired" ? "selected" : "" %>
            >
                Expired
            </option>

        </select>


        <select name="sort">

            <option
                value="earliest"
                <%= sort === "earliest" ? "selected" : "" %>
            >
                Deadline: Earliest First
            </option>

            <option
                value="latest"
                <%= sort === "latest" ? "selected" : "" %>
                >
                Deadline: Latest First
            </option>

        </select>


        <button
            type="submit"
            class="btn btn-primary"
        >
            <i data-lucide="search"></i>
            <span>Search</span>
        </button>

    </form>

</div>


<div class="content-card">

    <% if (universities.length === 0) { %>

        <div class="empty-state">

            <h2>No universities yet</h2>

            <p>
                Start by adding your first master's university.
            </p>

            <a
                href="/universities/add"
                class="btn btn-primary"
            >
                <i data-lucide="plus"></i>
                <span>Add University</span>
            </a>

        </div>

    <% } else { %>

        <div class="internship-list">

            <% universities.forEach(university => { %>

                <div class="internship-card">

                    <div>

                        <h2>
                            <%= university.universityName %>
                        </h2>


                        <p class="company">
                            <%= university.programName %>
                        </p>


                        <p>
                            <i data-lucide="globe-2"></i>
                            <span>
                                <%= university.country %>

                                <% if (university.city) { %>
                                    - <%= university.city %>
                                <% } %>
                            </span>
                        </p>


                        <p>
                            <i data-lucide="graduation-cap"></i>
                            <span>
                                <%= university.degree || "Not specified" %>
                            </span>
                        </p>

                    </div>


                    <div class="internship-info">

                        <p>

                            <strong>
                                <i data-lucide="calendar-days"></i>
                                Deadline:
                            </strong>

                            <% if (university.closingDate) { %>

                                <%= university.closingDate.toDateString() %>

                                <%
                                    const today = new Date();
                                    today.setHours(0, 0, 0, 0);

                                    const deadlineDate =
                                        new Date(university.closingDate);

                                    deadlineDate.setHours(0, 0, 0, 0);

                                    const difference =
                                        Math.ceil(
                                            (deadlineDate - today) /
                                            (1000 * 60 * 60 * 24)
                                        );
                                %>


                                <% if (difference < 0) { %>

                                    <span class="deadline-badge expired">
                                        <i data-lucide="circle-alert"></i>
                                        <span>Expired</span>
                                    </span>

                                <% } else if (difference <= 7) { %>

                                    <span class="deadline-badge soon">
                                        <i data-lucide="clock-3"></i>
                                        <span>Closing Soon</span>
                                    </span>

                                <% } else { %>

                                    <span class="deadline-badge open">
                                        <i data-lucide="check-circle-2"></i>
                                        <span>Open</span>
                                    </span>

                                <% } %>

                            <% } else { %>

                                Not specified

                            <% } %>

                        </p>


                        <p>

                            <strong>
                                <i data-lucide="wallet-cards"></i>
                                Tuition:
                            </strong>

                            <%= university.tuitionFee || "Not specified" %>

                        </p>


                        <p>

                            <strong>
                                <i data-lucide="circle-check"></i>
                                Status:
                            </strong>

                            <span class="status-badge">
                                <%= university.status %>
                            </span>

                        </p>

                    </div>


                    <div class="card-actions">

                        <a
                            href="/universities/view/<%= university._id %>"
                        >
                            <i data-lucide="eye"></i>
                            <span>View</span>
                        </a>


                        <a
                            href="/universities/edit/<%= university._id %>"
                            class="btn btn-secondary"
                        >
                            <i data-lucide="pencil"></i>
                            <span>Edit</span>
                        </a>


                        <form
                            action="/universities/delete/<%= university._id %>"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Are you sure you want to delete this university?')"
                            >
                                <i data-lucide="trash-2"></i>
                                <span>Delete</span>
                            </button>

                        </form>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>


<%- include("../partials/footer") %>