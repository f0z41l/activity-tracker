
</body><%- include("partials/header", { title: "Dashboard" }) %>


<!-- ========================================
     DASHBOARD HEADER
======================================== -->

<div class="page-header">

    <div>

        <h1>Dashboard</h1>

        <p>
            Overview of your career opportunities and personal tasks.
        </p>

    </div>

</div>


<!-- ========================================
     STATISTICS
======================================== -->

<div class="dashboard-stats">

    <!-- Internships -->

    <div class="stat-card">

        <div class="stat-card-top">

            <div class="stat-icon">
                🎓
            </div>

            <div>
                <p>Internships</p>

                <h2>
                    <%= internshipCount %>
                </h2>
            </div>

        </div>

        <div class="stat-details">

            <span>
                Applied
                <strong><%= internshipApplied %></strong>
            </span>

            <span>
                Not Applied
                <strong><%= internshipNotApplied %></strong>
            </span>

        </div>

        <a href="/internships">
            View Internships →
        </a>

    </div>


    <!-- Scholarships -->

    <div class="stat-card">

        <div class="stat-card-top">

            <div class="stat-icon">
                🏆
            </div>

            <div>
                <p>Scholarships</p>

                <h2>
                    <%= scholarshipCount %>
                </h2>
            </div>

        </div>

        <div class="stat-details">

            <span>
                Applied
                <strong><%= scholarshipApplied %></strong>
            </span>

            <span>
                Not Applied
                <strong><%= scholarshipNotApplied %></strong>
            </span>

        </div>

        <a href="/scholarships">
            View Scholarships →
        </a>

    </div>


    <!-- Universities -->

    <div class="stat-card">

        <div class="stat-card-top">

            <div class="stat-icon">
                🏫
            </div>

            <div>
                <p>Universities</p>

                <h2>
                    <%= universityCount %>
                </h2>
            </div>

        </div>

        <div class="stat-details">

            <span>
                Applied
                <strong><%= universityApplied %></strong>
            </span>

            <span>
                Not Applied
                <strong><%= universityNotApplied %></strong>
            </span>

        </div>

        <a href="/universities">
            View Universities →
        </a>

    </div>


    <!-- Jobs -->

    <div class="stat-card">

        <div class="stat-card-top">

            <div class="stat-icon">
                💼
            </div>

            <div>
                <p>Jobs</p>

                <h2>
                    <%= jobCount %>
                </h2>
            </div>

        </div>

        <div class="stat-details">

            <span>
                Applied
                <strong><%= jobApplied %></strong>
            </span>

            <span>
                Not Applied
                <strong><%= jobNotApplied %></strong>
            </span>

        </div>

        <a href="/jobs">
            View Jobs →
        </a>

    </div>


    <!-- Tasks -->

    <div class="stat-card">

        <div class="stat-card-top">

            <div class="stat-icon">
                ✅
            </div>

            <div>
                <p>Tasks</p>

                <h2>
                    <%= taskCount %>
                </h2>
            </div>

        </div>

        <div class="stat-details">

            <span>
                Pending
                <strong><%= pendingTaskCount %></strong>
            </span>

            <span>
                Completed
                <strong><%= completedTaskCount %></strong>
            </span>

        </div>

        <a href="/tasks">
            View Tasks →
        </a>

    </div>

</div>


<!-- ========================================
     TASK PROGRESS
======================================== -->

<div class="dashboard-grid">


    <div class="dashboard-card">

        <div class="dashboard-card-header">

            <div>

                <h2>Task Progress</h2>

                <p>
                    Your current task status.
                </p>

            </div>

            <a
                href="/tasks"
                class="btn btn-secondary"
            >
                View Tasks
            </a>

        </div>


        <div class="task-progress">


            <div class="progress-item">

                <div>

                    <span>Pending</span>

                    <strong>
                        <%= pendingTaskCount %>
                    </strong>

                </div>

            </div>


            <div class="progress-item">

                <div>

                    <span>Completed</span>

                    <strong>
                        <%= completedTaskCount %>
                    </strong>

                </div>

            </div>


        </div>

    </div>


    <!-- ========================================
         QUICK ACTIONS
    ======================================== -->

    <div class="dashboard-card">

        <div class="dashboard-card-header">

            <div>

                <h2>Quick Actions</h2>

                <p>
                    Add a new opportunity or task.
                </p>

            </div>

        </div>


        <div class="quick-actions">

            <a
                href="/internships/add"
                class="quick-action"
            >
                🎓 Add Internship
            </a>


            <a
                href="/scholarships/add"
                class="quick-action"
            >
                🏆 Add Scholarship
            </a>


            <a
                href="/universities/add"
                class="quick-action"
            >
                🏫 Add University
            </a>


            <a
                href="/jobs/add"
                class="quick-action"
            >
                💼 Add Job
            </a>


            <a
                href="/tasks/add"
                class="quick-action"
            >
                ✅ Add Task
            </a>

        </div>

    </div>


</div>

<!-- ========================================
     UPCOMING DEADLINES
======================================== -->

<div class="dashboard-card upcoming-card">

    <div class="dashboard-card-header">

        <div>

            <h2>Upcoming Deadlines</h2>

            <p>
                Your nearest application and task deadlines.
            </p>

        </div>

    </div>


    <% if (upcomingDeadlines.length === 0) { %>

        <div class="empty-state">

            <h3>No upcoming deadlines</h3>

            <p>
                You currently have no upcoming deadlines.
            </p>

        </div>


    <% } else { %>


        <div class="deadline-list">


            <% upcomingDeadlines.forEach(item => { %>

                <div class="dashboard-deadline">


                    <div class="deadline-main">

                        <h3>
                            <%= item.title %>
                        </h3>

                        <p>
                            <%= item.organization %>
                        </p>

                    </div>


                    <div class="deadline-type">

                        <span class="status-badge">
                            <%= item.type %>
                        </span>

                    </div>


                    <div class="deadline-date">

                        <strong>
                            <%= new Date(item.date).toLocaleDateString() %>
                        </strong>


                        <% if (item.deadlineStatus) { %>

                            <span class="deadline-reminder">

                                <% if (item.deadlineStatus === "Due Today") { %>

                                    🔴 Due Today

                                <% } else if (item.deadlineStatus === "Due Soon") { %>

                                    🟠 <%= item.daysLeft %>
                                    day<%= item.daysLeft === 1 ? "" : "s" %> left

                                <% } else if (item.deadlineStatus === "Upcoming") { %>

                                    🟡 <%= item.daysLeft %> days left

                                <% } else if (item.deadlineStatus === "Expired") { %>

                                    🔴 Expired

                                <% } %>

                            </span>

                        <% } %>


                        <a href="<%= item.link %>">
                            View
                        </a>

                    </div>


                </div>

            <% }) %>


        </div>


    <% } %>

</div>

<!-- ========================================
     EXPIRED OPPORTUNITIES
======================================== -->

<div class="dashboard-card expired-card">

    <div class="dashboard-card-header">

        <div>

            <h2>Expired Opportunities</h2>

            <p>
                Opportunities whose deadlines have already passed.
            </p>

        </div>

    </div>


    <% if (expiredOpportunities.length === 0) { %>

        <div class="empty-state">

            <h3>No expired opportunities</h3>

            <p>
                You currently have no expired opportunities.
            </p>

        </div>


    <% } else { %>


        <div class="deadline-list">


            <% expiredOpportunities.forEach(item => { %>

                <div class="dashboard-deadline">


                    <div class="deadline-main">

                        <h3>
                            <%= item.title %>
                        </h3>

                        <p>
                            <%= item.organization %>
                        </p>

                    </div>


                    <div class="deadline-type">

                        <span class="status-badge">
                            <%= item.type %>
                        </span>

                    </div>


                    <div class="deadline-date">

                        <strong>
                            <%= new Date(item.date).toLocaleDateString() %>
                        </strong>

                        <span class="deadline-reminder expired">
                            🔴 Expired
                        </span>

                        <a href="<%= item.link %>">
                            View
                        </a>

                    </div>


                </div>

            <% }) %>


        </div>


    <% } %>

</div>
