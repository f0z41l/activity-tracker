<%- include("../partials/header", { title: "Scholarships" }) %>

<div class="page-header">

    <div>

        <h1>Scholarships</h1>

        <p>
            Manage and track your scholarship opportunities.
        </p>

    </div>

    <a
        href="/scholarships/add"
        class="btn btn-primary"
    >
        + Add Scholarship
    </a>

</div>


<!-- Search and Filters -->

<div class="search-bar">

    <form
        action="/scholarships"
        method="GET"
    >

        <input
            type="text"
            name="search"
            placeholder="Search scholarships..."
            value="<%= search || '' %>"
        >


        <select name="country">

            <option value="">
                All Countries
            </option>

            <% countries.forEach(item => { %>

                <option
                    value="<%= item %>"
                    <%= country === item ? "selected" : "" %>
                >
                    <%= item %>
                </option>

            <% }) %>

        </select>


        <select name="status">

            <option value="">
                All Status
            </option>

            <option
                value="Not Applied"
                <%= status === "Not Applied" ? "selected" : "" %>
            >
                Not Applied
            </option>

            <option
                value="Applied"
                <%= status === "Applied" ? "selected" : "" %>
            >
                Applied
            </option>

        </select>


        <select name="deadline">

            <option value="">
                All Deadlines
            </option>

            <option
                value="open"
                <%= deadline === "open" ? "selected" : "" %>
            >
                Open
            </option>

            <option
                value="closingSoon"
                <%= deadline === "closingSoon" ? "selected" : "" %>
            >
                Closing Soon
            </option>

            <option
                value="expired"
                <%= deadline === "expired" ? "selected" : "" %>
            >
                Expired
            </option>

        </select>


        <select name="sort">

            <option
                value="earliest"
                <%= sort === "earliest" ? "selected" : "" %>
            >
                Deadline: Earliest First
            </option>

            <option
                value="latest"
                <%= sort === "latest" ? "selected" : "" %>
            >
                Deadline: Latest First
            </option>

        </select>


        <button
            type="submit"
            class="btn btn-primary"
        >
            Search
        </button>

    </form>

</div>


<!-- Scholarship List -->

<div class="content-card">

    <% if (scholarships.length === 0) { %>

        <div class="empty-state">

            <h2>No scholarships yet</h2>

            <p>
                Start by adding your first scholarship opportunity.
            </p>

            <a
                href="/scholarships/add"
                class="btn btn-primary"
            >
                Add Scholarship
            </a>

        </div>

    <% } else { %>


        <div class="internship-list">

            <% scholarships.forEach(scholarship => { %>

                <div class="internship-card">

                    <div>

                        <h2>
                            <%= scholarship.name %>
                        </h2>

                        <p class="company">
                            <%= scholarship.provider %>
                        </p>

                        <p>
                            🌍 <%= scholarship.country %>
                        </p>

                        <p>
                            💰 <%= scholarship.funding || "Not specified" %>
                        </p>

                    </div>


                    <div class="internship-info">

                        <p>

                            <strong>Deadline:</strong>

                            <% if (scholarship.closingDate) { %>

                                <%= scholarship.closingDate.toDateString() %>


                                <%
                                    const today = new Date();

                                    today.setHours(0, 0, 0, 0);

                                    const deadlineDate =
                                        new Date(
                                            scholarship.closingDate
                                        );

                                    deadlineDate.setHours(
                                        0, 0, 0, 0
                                    );

                                    const difference =
                                        Math.ceil(
                                            (deadlineDate - today) /
                                            (1000 * 60 * 60 * 24)
                                        );
                                %>


                                <% if (difference < 0) { %>

                                    <span class="deadline-badge expired">
                                        Expired
                                    </span>

                                <% } else if (difference <= 7) { %>

                                    <span class="deadline-badge soon">
                                        Closing Soon
                                    </span>

                                <% } else { %>

                                    <span class="deadline-badge open">
                                        Open
                                    </span>

                                <% } %>

                            <% } else { %>

                                Not specified

                            <% } %>

                        </p>


                        <p>

                            <strong>Status:</strong>

                            <span class="status-badge">
                                <%= scholarship.status %>
                            </span>

                        </p>

                    </div>


                    <div class="card-actions">

                        <a
                            href="/scholarships/edit/<%= scholarship._id %>"
                            class="btn btn-secondary"
                        >
                            Edit
                        </a>


                        <form
                            action="/scholarships/delete/<%= scholarship._id %>"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Are you sure you want to delete this scholarship?')"
                            >
                                Delete
                            </button>

                        </form>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>


<%- include("../partials/footer") %>